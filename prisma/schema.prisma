generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MembershipStatus {
  VISITOR
  MEMBER
  WORKER
  LEADER
  PASTOR
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  CONVERTED
  INACTIVE
}

enum CheckInReason {
  ABSENTEEISM
  ILLNESS
  BEREAVEMENT
  WORKER_WELFARE
  DISCIPLESHIP
  FAMILY_SUPPORT
  GENERAL_CHECK_IN
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum OutreachPurpose {
  BIRTHDAY
  VISITOR_FOLLOW_UP
  PASTORAL_CHECK_IN
  PROFILE_LINK
}

enum RelationshipType {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  OTHER
}

enum OutreachStatus {
  OPENED
  CONFIRMED_SENT
  NOT_SENT
}

enum CheckInStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EventCategory {
  GENERAL
  CONFERENCE
  VIGIL
  COMMUNION
  REVIVAL
  WORSHIP
  OUTREACH
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum EmailDeliveryStatus {
  DELIVERABLE
  BOUNCED
  DROPPED
  COMPLAINED
}

model Church {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(100)
  shortName      String?  @map("short_name") @db.VarChar(50)
  branchName     String?  @map("branch_name") @db.VarChar(255)
  campusName     String?  @map("campus_name") @db.VarChar(255)
  address        String?  @db.Text
  phone          String?  @db.VarChar(50)
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(20)
  email          String?  @db.VarChar(255)
  websiteUrl     String?  @map("website_url") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users                 User[]
  people                Person[]
  events                Event[]
  departments           Department[]
  contactSubmissions    ContactSubmission[]
  birthdayGreetings     BirthdayGreeting[]
  pastoralCheckIns      PastoralCheckIn[]
  messageTemplates      MessageTemplate[]
  outreachMessages      OutreachMessage[]
  givingAccounts        GivingAccount[]
  confessions           Confession[]
  scriptures            Scripture[]
  pushSubscriptions     PushSubscription[]
  nightPrayer           NightPrayer?
  encouragementMessages EncouragementMessage[]
  notificationSettings  NotificationSettings?
  relationships         PersonRelationship[]

  @@map("churches")
}

model User {
  id                String              @id @default(uuid())
  churchId          String              @map("church_id")
  email             String              @unique @db.VarChar(255)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  firstName         String              @map("first_name") @db.VarChar(100)
  lastName          String              @map("last_name") @db.VarChar(100)
  displayName       String?             @map("display_name") @db.VarChar(100)
  phone             String?             @db.VarChar(50)
  isActive          Boolean             @default(true) @map("is_active")
  lastActive        DateTime?           @map("last_active")
  emailStatus       EmailDeliveryStatus @default(DELIVERABLE) @map("email_status")
  emailBounceReason String?             @map("email_bounce_reason") @db.Text
  emailBouncedAt    DateTime?           @map("email_bounced_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  church                Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userRoles             UserRole[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  sentBirthdayGreetings BirthdayGreeting[] @relation("SentBirthdayGreetings")
  createdCheckIns       PastoralCheckIn[]  @relation("CheckInCreatedBy")
  assignedCheckIns      PastoralCheckIn[]  @relation("CheckInAssignedTo")
  outreachMessages      OutreachMessage[]  @relation("OutreachSentBy")
  person                Person?            @relation("UserPerson")

  @@index([churchId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Person {
  id                    String              @id @default(uuid())
  churchId              String              @map("church_id")
  firstName             String              @map("first_name") @db.VarChar(100)
  lastName              String              @map("last_name") @db.VarChar(100)
  email                 String?             @db.VarChar(255)
  phone                 String?             @db.VarChar(50)
  gender                Gender?
  membershipStatus      MembershipStatus    @default(VISITOR) @map("membership_status")
  dateOfBirth           DateTime?           @map("date_of_birth") @db.Date
  address               String?             @db.Text
  emailStatus           EmailDeliveryStatus @default(DELIVERABLE) @map("email_status")
  emailBounceReason     String?             @map("email_bounce_reason") @db.Text
  emailBouncedAt        DateTime?           @map("email_bounced_at")
  emailOptOut           Boolean             @default(false) @map("email_opt_out")
  emailOptOutAt         DateTime?           @map("email_opt_out_at")
  whatsappOptOut        Boolean             @default(false) @map("whatsapp_opt_out")
  whatsappOptOutAt      DateTime?           @map("whatsapp_opt_out_at")
  profileToken          String?             @unique @map("profile_token") @db.VarChar(255)
  profileTokenExpiresAt DateTime?           @map("profile_token_expires_at")
  profileTokenOpenedAt  DateTime?           @map("profile_token_opened_at")
  namesConfirmed        Boolean             @default(true) @map("names_confirmed")
  pinHash               String?             @map("pin_hash") @db.VarChar(255)
  pinFailedAttempts     Int                 @default(0) @map("pin_failed_attempts")
  pinLockedUntil        DateTime?           @map("pin_locked_until")
  userId                String?             @unique @map("user_id")
  followUpStatus        FollowUpStatus?     @map("follow_up_status")
  followUpNotes         String?             @map("follow_up_notes") @db.Text
  lastFollowUpAt        DateTime?           @map("last_follow_up_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  church                Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user                  User?                  @relation("UserPerson", fields: [userId], references: [id], onDelete: SetNull)
  registrations         Registration[]
  birthdayGreetings     BirthdayGreeting[]
  departmentMemberships DepartmentMembership[]
  pastoralCheckIns      PastoralCheckIn[]
  outreachMessages      OutreachMessage[]
  pushSubscriptions     PushSubscription[]
  relationshipsFrom     PersonRelationship[]   @relation("RelationshipFrom")
  relationshipsTo       PersonRelationship[]   @relation("RelationshipTo")
  createdRelationships  PersonRelationship[]   @relation("RelationshipCreatedBy")

  @@unique([churchId, email])
  @@unique([churchId, phone])
  @@index([churchId])
  @@index([followUpStatus])
  @@map("people")
}

model PersonRelationship {
  id                String           @id @default(uuid())
  churchId          String           @map("church_id")
  personId          String           @map("person_id")
  relatedPersonId   String           @map("related_person_id")
  type              RelationshipType
  note              String?          @db.VarChar(100)
  createdByPersonId String?          @map("created_by_person_id")
  createdByUserId   String?          @map("created_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  church        Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person        Person  @relation("RelationshipFrom", fields: [personId], references: [id], onDelete: Cascade)
  relatedPerson Person  @relation("RelationshipTo", fields: [relatedPersonId], references: [id], onDelete: Cascade)
  createdBy     Person? @relation("RelationshipCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  @@unique([personId, relatedPersonId])
  @@index([relatedPersonId])
  @@index([churchId])
  @@map("person_relationships")
}

model Event {
  id                   String        @id @default(uuid())
  churchId             String        @map("church_id")
  title                String        @db.VarChar(255)
  description          String?       @db.Text
  category             EventCategory @default(GENERAL)
  location             String?       @db.VarChar(255)
  startDate            DateTime      @map("start_date")
  endDate              DateTime      @map("end_date")
  status               EventStatus   @default(DRAFT)
  imageUrl             String?       @map("image_url") @db.VarChar(512)
  googleCalendarSync   Boolean       @default(false) @map("google_calendar_sync")
  capacity             Int?          @map("capacity")
  requiresRegistration Boolean       @default(true) @map("requires_registration")
  highlights           Json?         @map("highlights")
  isFeatured           Boolean       @default(false) @map("is_featured")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  church        Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  registrations Registration[]
  teams         Team[]
  games         Game[]

  @@index([churchId])
  @@index([status])
  @@index([startDate])
  @@index([churchId, status, startDate])
  @@index([churchId, requiresRegistration])
  @@index([churchId, isFeatured])
  @@index([churchId, category])
  @@map("events")
}

model Team {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  scores        Score[]

  @@index([eventId])
  @@map("teams")
}

model Registration {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  personId           String             @map("person_id")
  teamId             String?            @map("team_id")
  registrationNumber String             @unique @map("registration_number") @db.VarChar(50)
  token              String             @unique @db.VarChar(255)
  status             RegistrationStatus @default(PENDING)
  googleCalendarSync Boolean            @default(false) @map("google_calendar_sync")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  attendance Attendance?

  @@unique([eventId, personId])
  @@index([eventId])
  @@index([personId])
  @@index([teamId])
  @@index([status])
  @@map("registrations")
}

model Attendance {
  id             String   @id @default(uuid())
  registrationId String   @unique @map("registration_id")
  checkedInAt    DateTime @default(now()) @map("checked_in_at")
  checkedInBy    String?  @map("checked_in_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("attendance")
}

model Game {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  name        String   @db.VarChar(150)
  description String?  @db.Text
  maxScore    Int?     @map("max_score")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores Score[]

  @@index([eventId])
  @@map("games")
}

model Score {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  teamId    String   @map("team_id")
  points    Int      @default(0)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([teamId])
  @@map("scores")
}

model EmailBounce {
  id               String    @id @default(uuid())
  churchId         String?   @map("church_id")
  email            String    @db.VarChar(255)
  resendEmailId    String?   @map("resend_email_id") @db.VarChar(255)
  eventType        String    @map("event_type") @db.VarChar(50)
  bounceType       String?   @map("bounce_type") @db.VarChar(50)
  reason           String?   @db.Text
  recipientType    String?   @map("recipient_type") @db.VarChar(50)
  recipientId      String?   @map("recipient_id") @db.VarChar(255)
  emailType        String?   @map("email_type") @db.VarChar(50)
  registrationId   String?   @map("registration_id") @db.VarChar(255)
  broadcastContent Json?     @map("broadcast_content")
  isResolved       Boolean   @default(false) @map("is_resolved")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedBy       String?   @map("resolved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([churchId])
  @@index([email])
  @@index([isResolved])
  @@map("email_bounces")
}

// Records what each outbound Resend email actually was, keyed by the id Resend
// returns from its send API. Resend's bounce/complaint webhooks echo back only
// `email_id` (no custom headers, and tags are a restricted 256-char ASCII-only
// key/value store) — so this table, not email headers, is how a later bounce
// event is linked back to its original email's type and content for resending.
model EmailSendLog {
  id               String   @id @default(uuid())
  resendEmailId    String   @unique @map("resend_email_id") @db.VarChar(255)
  emailType        String   @map("email_type") @db.VarChar(50)
  churchId         String?  @map("church_id")
  recipientEmail   String?  @map("recipient_email") @db.VarChar(255)
  recipientName    String?  @map("recipient_name") @db.VarChar(255)
  subject          String?  @db.VarChar(255)
  personId         String?  @map("person_id")
  userId           String?  @map("user_id")
  registrationId   String?  @map("registration_id") @db.VarChar(255)
  sentByUserId     String?  @map("sent_by_user_id")
  broadcastContent Json?    @map("broadcast_content")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([churchId])
  @@index([churchId, createdAt])
  @@index([emailType])
  @@index([recipientEmail])
  @@index([sentByUserId])
  @@map("email_send_logs")
}

model ContactSubmission {
  id        String   @id @db.VarChar(50)
  churchId  String   @map("church_id")
  type      String   @db.VarChar(20) // "prayer" or "inquiry"
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  category  String   @db.VarChar(100)
  message   String   @db.Text
  isPrivate Boolean  @default(false) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
  @@index([type])
  @@map("contact_submissions")
}

model BirthdayGreeting {
  id            String         @id @default(uuid())
  churchId      String         @map("church_id")
  personId      String         @map("person_id")
  sentByUserId  String         @map("sent_by_user_id")
  year          Int
  channel       MessageChannel @default(EMAIL)
  subject       String?        @db.VarChar(255)
  heading       String?        @db.VarChar(255)
  message       String         @db.Text
  imageUrl      String?        @map("image_url") @db.VarChar(512)
  ctaLabel      String?        @map("cta_label") @db.VarChar(100)
  ctaUrl        String?        @map("cta_url") @db.VarChar(512)
  resendEmailId String?        @map("resend_email_id") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  sentBy User   @relation("SentBirthdayGreetings", fields: [sentByUserId], references: [id], onDelete: Cascade)

  @@unique([personId, year, channel], name: "unique_person_year_channel_greeting")
  @@index([churchId])
  @@index([churchId, year])
  @@index([personId])
  @@index([sentByUserId])
  @@map("birthday_greetings")
}

model Department {
  id          String   @id @default(uuid())
  churchId    String   @map("church_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  church  Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members DepartmentMembership[]

  @@unique([churchId, name])
  @@index([churchId])
  @@map("departments")
}

model DepartmentMembership {
  id           String   @id @default(uuid())
  personId     String   @map("person_id")
  departmentId String   @map("department_id")
  role         String?  @db.VarChar(50)
  joinedAt     DateTime @default(now()) @map("joined_at")

  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([personId, departmentId])
  @@index([personId])
  @@index([departmentId])
  @@map("department_memberships")
}

model PastoralCheckIn {
  id           String        @id @default(uuid())
  churchId     String        @map("church_id")
  personId     String        @map("person_id")
  createdById  String        @map("created_by_id")
  assignedToId String?       @map("assigned_to_id")
  reason       CheckInReason @default(GENERAL_CHECK_IN)
  status       CheckInStatus @default(SCHEDULED)
  scheduledFor DateTime?     @map("scheduled_for")
  completedAt  DateTime?     @map("completed_at")
  notes        String?       @db.Text
  outcome      String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  church     Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person     Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("CheckInCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?             @relation("CheckInAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  outreach   OutreachMessage[]

  @@index([churchId])
  @@index([personId])
  @@index([status])
  @@index([assignedToId])
  @@index([scheduledFor])
  @@map("pastoral_check_ins")
}

model MessageTemplate {
  id            String          @id @default(uuid())
  churchId      String          @map("church_id")
  channel       MessageChannel  @default(WHATSAPP)
  purpose       OutreachPurpose
  checkInReason CheckInReason?  @map("check_in_reason")
  name          String          @db.VarChar(100)
  body          String          @db.Text
  isActive      Boolean         @default(true) @map("is_active")
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  church   Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  outreach OutreachMessage[]

  @@index([churchId, channel, purpose, isActive])
  @@map("message_templates")
}

// WhatsApp outreach sent by staff via click-to-chat. EmailSendLog stays the
// source of truth for email because it is keyed by Resend's id for bounces.
enum GivingCurrency {
  NGN
  USD
  GBP
  EUR
}

enum GivingPurpose {
  TITHE
  OFFERING
  BUILDING
  MISSIONS
  SEED
  SPECIAL
}

model GivingAccount {
  id            String         @id @default(uuid())
  churchId      String         @map("church_id")
  label         String         @db.VarChar(100)
  bankName      String         @map("bank_name") @db.VarChar(100)
  accountName   String         @map("account_name") @db.VarChar(255)
  accountNumber String         @map("account_number") @db.VarChar(34)
  currency      GivingCurrency @default(NGN)
  note          String?        @db.VarChar(500)
  purposes      Json
  sortOrder     Int            @default(0) @map("sort_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  updatedById   String?        @map("updated_by_id")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, isActive, sortOrder])
  @@map("giving_accounts")
}

model OutreachMessage {
  id           String          @id @default(uuid())
  churchId     String          @map("church_id")
  personId     String          @map("person_id")
  sentByUserId String          @map("sent_by_user_id")
  channel      MessageChannel  @default(WHATSAPP)
  purpose      OutreachPurpose
  checkInId    String?         @map("check_in_id")
  birthdayYear Int?            @map("birthday_year")
  templateId   String?         @map("template_id")
  toPhone      String          @map("to_phone") @db.VarChar(20)
  body         String          @db.Text
  status       OutreachStatus  @default(OPENED)
  openedAt     DateTime        @default(now()) @map("opened_at")
  confirmedAt  DateTime?       @map("confirmed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  church   Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person   Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  sentBy   User             @relation("OutreachSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  checkIn  PastoralCheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([churchId, createdAt])
  @@index([personId, createdAt])
  @@index([sentByUserId, status])
  @@index([purpose, status])
  @@map("outreach_messages")
}

enum ConfessionStatus {
  DRAFT
  PUBLISHED
}

enum ConfessionVoice {
  FEMALE
  MALE
}

model Confession {
  id           String           @id @default(uuid())
  churchId     String           @map("church_id")
  title        String           @db.VarChar(150)
  slug         String           @db.VarChar(160)
  body         String           @db.Text
  scriptureRef String?          @map("scripture_ref") @db.VarChar(100)
  category     String?          @db.VarChar(50)
  status       ConfessionStatus @default(DRAFT)
  sortOrder    Int              @default(0) @map("sort_order")
  publishedAt  DateTime?        @map("published_at")
  listenCount  Int              @default(0) @map("listen_count")
  createdById  String?          @map("created_by_id")
  updatedById  String?          @map("updated_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  church    Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  audio     ConfessionAudio[]
  reminders ConfessionReminder[]

  @@unique([churchId, slug])
  @@index([churchId, status, sortOrder])
  @@map("confessions")
}

model ConfessionAudio {
  id           String          @id @default(uuid())
  confessionId String          @map("confession_id")
  voice        ConfessionVoice
  url          String          @db.VarChar(512)
  durationSec  Int             @map("duration_sec")
  sizeBytes    Int             @map("size_bytes")
  textHash     String          @map("text_hash") @db.VarChar(64)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  confession Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)

  @@unique([confessionId, voice])
  @@map("confession_audio")
}

enum ScriptureKind {
  WEEK
  YEAR
}

enum ScriptureStatus {
  DRAFT
  PUBLISHED
}

model Scripture {
  id            String          @id @default(uuid())
  churchId      String          @map("church_id")
  kind          ScriptureKind
  text          String          @db.VarChar(1500)
  reference     String          @db.VarChar(100)
  translation   String?         @db.VarChar(20)
  givenBy       String?         @map("given_by") @db.VarChar(100)
  startsOn      DateTime        @map("starts_on") @db.Date
  status        ScriptureStatus @default(DRAFT)
  notifyMembers Boolean         @default(true) @map("notify_members")
  notifiedAt    DateTime?       @map("notified_at")
  createdById   String?         @map("created_by_id")
  updatedById   String?         @map("updated_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, kind, status, startsOn])
  @@map("scriptures")
}

model PushSubscription {
  id           String   @id @default(uuid())
  churchId     String   @map("church_id")
  endpoint     String   @unique(length: 500) @db.VarChar(1024)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  topics       Json
  personId     String?  @map("person_id")
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  failureCount Int      @default(0) @map("failure_count")
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")

  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@map("push_subscriptions")
}

model NightPrayer {
  id                 String   @id @default(uuid())
  churchId           String   @unique @map("church_id")
  title              String   @db.VarChar(150)
  description        String?  @db.Text
  imageUrl           String?  @map("image_url") @db.VarChar(512)
  meetUrl            String   @map("meet_url") @db.VarChar(255)
  timeOfDay          String   @map("time_of_day") @db.VarChar(5)
  durationMin        Int      @default(60) @map("duration_min")
  joinOpensMinBefore Int      @default(10) @map("join_opens_min_before")
  daysOfWeek         Json
  reminderOffsetsMin Json     @map("reminder_offsets_min")
  isActive           Boolean  @default(true) @map("is_active")
  updatedById        String?  @map("updated_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  church     Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  exceptions NightPrayerException[]

  @@map("night_prayers")
}

model NightPrayerException {
  id            String   @id @default(uuid())
  nightPrayerId String   @map("night_prayer_id")
  date          DateTime @db.Date
  cancelled     Boolean  @default(true)
  note          String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  nightPrayer NightPrayer @relation(fields: [nightPrayerId], references: [id], onDelete: Cascade)

  @@unique([nightPrayerId, date])
  @@map("night_prayer_exceptions")
}

model ConfessionReminder {
  id           String    @id @default(uuid())
  confessionId String    @map("confession_id")
  timeOfDay    String    @map("time_of_day") @db.VarChar(5)
  daysOfWeek   Json
  startsOn     DateTime? @map("starts_on") @db.Date
  endsOn       DateTime? @map("ends_on") @db.Date
  message      String?   @db.VarChar(200)
  createdAt    DateTime  @default(now()) @map("created_at")

  confession Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)

  @@index([confessionId])
  @@map("confession_reminders")
}

model EncouragementMessage {
  id         String    @id @default(uuid())
  churchId   String    @map("church_id")
  text       String    @db.VarChar(240)
  reference  String?   @db.VarChar(100)
  isActive   Boolean   @default(true) @map("is_active")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, isActive, lastSentAt])
  @@map("encouragement_messages")
}

model NotificationSettings {
  id                 String   @id @default(uuid())
  churchId           String   @unique @map("church_id")
  scriptureSendTime  String   @default("07:00") @map("scripture_send_time") @db.VarChar(5)
  encouragementSlots Json     @default("[]") @map("encouragement_slots")
  updatedAt          DateTime @updatedAt @map("updated_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model NotificationLog {
  id         String   @id @default(uuid())
  churchId   String   @map("church_id")
  key        String   @unique @db.VarChar(255)
  topic      String   @db.VarChar(30)
  title      String   @db.VarChar(150)
  body       String   @db.VarChar(300)
  url        String   @db.VarChar(255)
  recipients Int      @default(0)
  delivered  Int      @default(0)
  failed     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([churchId, createdAt])
  @@map("notification_log")
}

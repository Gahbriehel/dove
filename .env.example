PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/church_events"

JWT_SECRET="<your-jwt-secret>"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="<your-jwt-refresh-secret>"
JWT_REFRESH_EXPIRES_IN="7d"

SUPER_ADMIN_EMAIL="<super-admin-email>"
SUPER_ADMIN_PASSWORD="<super-admin-password>"

# Email & Portal Configuration
RESEND_API_KEY="<your-resend-api-key>"
RESEND_WEBHOOK_SECRET="whsec_<your-resend-webhook-signing-secret>"
EMAIL_FROM="onboarding@resend.dev"
LOGIN_URL="http://localhost:3000/login"
APP_URL="http://localhost:3000"
# Base URL of the member PWA profile page (token is appended). Production: https://app.abwog.org/profile
PROFILE_URL="http://localhost:5173/profile"

# Web Push & Scheduled Notifications
VAPID_PUBLIC_KEY="<vapid-public-key>"
VAPID_PRIVATE_KEY="<vapid-private-key>"
VAPID_SUBJECT="mailto:info@abwog.org"
CRON_SECRET="<random-cron-secret>"
PUSH_TIMEZONE="Africa/Lagos"


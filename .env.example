PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/church_events"

JWT_SECRET="<your-jwt-secret>"
JWT_EXPIRES_IN="1d"
